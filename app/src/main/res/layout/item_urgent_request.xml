<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: Badge and Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/typeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="BLOOD"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/dateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Details / Blood group and Request ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detailsView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A+"
                android:textColor="#C62828"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/requestIdView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Request #123"
                android:textColor="#6B7280"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Clean label/value lines -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2">

            <!-- Hospital -->
            <TextView
                android:id="@+id/hospitalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hospital:"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:paddingEnd="8dp" />
            <TextView
                android:id="@+id/hospitalView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1F1B4D"
                android:textSize="13sp" />

            <!-- City -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="City:"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:paddingEnd="8dp"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/cityView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1F1B4D"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <!-- Units -->
            <TextView
                android:id="@+id/unitsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Units:"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:paddingEnd="8dp"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/unitsView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1F1B4D"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <!-- Reason -->
            <TextView
                android:id="@+id/reasonLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reason:"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:paddingEnd="8dp"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/reasonView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1F1B4D"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <!-- Contact -->
            <TextView
                android:id="@+id/contactLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact:"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:paddingEnd="8dp"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/contactView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#1F1B4D"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />
        </GridLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/donateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="I Can Donate"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:backgroundTint="#C62828"
            app:cornerRadius="12dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
